//  Component-local erased-owner payload catalogue fragment.
//  Defines MV_HOST_ERASED_OWNER_PAYLOADS(payload_macro, payload_with_storage_macro).

#define MV_HOST_ERASED_OWNER_PAYLOADS(payload_macro, payload_with_storage_macro) \
    payload_with_storage_macro(ByteStorage, buffer) \
    payload_with_storage_macro(BakedDocumentAsset, block) \
    payload_macro(BorrowedBundleAsset) \
    payload_with_storage_macro(BundleBuildResult, block) \
    payload_with_storage_macro(DocumentConditionResult, storage) \
    payload_with_storage_macro(LiveDocumentAsset, document) \
    payload_with_storage_macro(FilesystemScanResult, document)
