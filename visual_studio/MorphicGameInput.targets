<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <MorphicGameInputRoot>$(MSBuildThisFileDirectory)..\build\dependencies\gameinput\4.0.306\package</MorphicGameInputRoot>
    <MorphicGameInputArch Condition="'$(Platform)'=='Win32'">x86</MorphicGameInputArch>
    <MorphicGameInputArch Condition="'$(Platform)'=='x64'">x64</MorphicGameInputArch>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(MorphicGameInputRoot)\native\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <AdditionalDependencies>$(MorphicGameInputRoot)\native\lib\$(MorphicGameInputArch)\GameInput.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <Target Name="MorphicAcquireGameInput" BeforeTargets="PrepareForBuild">
    <!-- CI launches MSBuild from PowerShell 7. Let Windows PowerShell construct
         its own module path instead of inheriting incompatible PS7 modules. -->
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\tools\acquire_gameinput.ps1&quot;"
          EnvironmentVariables="PSModulePath=" />
  </Target>
  <Target Name="MorphicStageGameInput" AfterTargets="Build">
    <ItemGroup>
      <MorphicGameInputBinary Include="$(MorphicGameInputRoot)\native\bin\$(MorphicGameInputArch)\GameInputRedist.dll;$(MorphicGameInputRoot)\native\bin\$(MorphicGameInputArch)\GameInputRawInputProxy.exe" />
      <MorphicGameInputLicence Include="$(MorphicGameInputRoot)\LICENSE.txt;$(MorphicGameInputRoot)\NOTICE.txt" />
    </ItemGroup>
    <Copy SourceFiles="@(MorphicGameInputBinary)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(MorphicGameInputLicence)" DestinationFolder="$(OutDir)gameinput-licences" SkipUnchangedFiles="true" />
  </Target>
</Project>
