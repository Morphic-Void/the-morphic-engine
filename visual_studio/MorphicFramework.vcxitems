<?xml version="1.0" encoding="utf-8"?>
<!--
  File:    MorphicFramework.vcxitems
  Date:    04 Nov 26

  Shares public component contracts with Host, modules and fixtures without
  compiling implementation sources or importing Core's shared source items.
-->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Label="Globals">
    <MSBuildAllProjects Condition="'$(MSBuildVersion)' == '' Or '$(MSBuildVersion)' &lt; '16.0'">$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
    <HasSharedItems>true</HasSharedItems>
    <ItemsProjectGuid>{093DF26D-776A-4556-91E0-16DC0EC4AE94}</ItemsProjectGuid>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(MSBuildThisFileDirectory)..\;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ProjectCapability Include="SourceItemsFromImports" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="$(MSBuildThisFileDirectory)..\framework\platform\window.hpp" />
    <ClInclude Include="$(MSBuildThisFileDirectory)..\framework\platform\input.hpp" />
    <ClInclude Include="$(MSBuildThisFileDirectory)..\framework\platform\input_state.hpp" />
    <ClInclude Include="$(MSBuildThisFileDirectory)..\framework\platform\input_reader.hpp" />
    <ClInclude Include="$(MSBuildThisFileDirectory)..\framework\communications\direct_connection.hpp" />
    <ClInclude Include="$(MSBuildThisFileDirectory)..\framework\communications\direct_client.hpp" />
    <ClInclude Include="$(MSBuildThisFileDirectory)..\framework\communications\module_tests.hpp" />
    <ClInclude Include="$(MSBuildThisFileDirectory)..\framework\platform\window_state.hpp" />
  </ItemGroup>
</Project>
