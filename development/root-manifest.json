{
  "schemaVersion": 2,
  "profile": "development-filesystem",
  "roots": {
    "package:": {
      "source": "logical-roots/package",
      "writable": false,
      "content": {
        "bin": {
          "source": "executable-directory",
          "extensions": [
            "dll"
          ],
          "writable": false
        }
      }
    },
    "dev-source:": {
      "source": "logical-roots/dev-source",
      "writable": true
    },
    "dev-workspace:": {
      "source": "logical-roots/dev-workspace",
      "writable": true
    },
    "config:": {
      "source": "logical-roots/config",
      "writable": true
    },
    "save:": {
      "source": "logical-roots/saves",
      "writable": true
    },
    "state:": {
      "source": "logical-roots/state",
      "writable": true
    },
    "logs:": {
      "source": "logical-roots/logs",
      "writable": true,
      "inventory": false
    },
    "test-logs:": {
      "source": "logical-roots/test-logs",
      "writable": true,
      "inventory": false
    },
    "cache:": {
      "source": "logical-roots/cache",
      "writable": true
    },
    "test-output:": {
      "source": "logical-roots/test-output",
      "writable": true
    },
    "ugc-work:": {
      "source": "logical-roots/ugc-work",
      "writable": true
    },
    "ugc-inbox:": {
      "source": "logical-roots/ugc-inbox",
      "writable": true
    },
    "ugc-installed:": {
      "source": "logical-roots/ugc-installed",
      "writable": false
    }
  }
}
