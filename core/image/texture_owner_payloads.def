//  Shared texture SYSTEM erased-owner payload declarations.
//  Include this file with:
//  - MV_ERASED_OWNER_PAYLOAD(type)
//  - MV_ERASED_OWNER_PAYLOAD_WITH_STORAGE(type, member)

MV_ERASED_OWNER_PAYLOAD_WITH_STORAGE(TextureEncodeRequest, input)
MV_ERASED_OWNER_PAYLOAD(TextureDecodeRequest)
MV_ERASED_OWNER_PAYLOAD_WITH_STORAGE(TextureEncodeResult, texture)
MV_ERASED_OWNER_PAYLOAD_WITH_STORAGE(TextureDecodeResult, texture)
